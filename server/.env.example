# Supabase (copy verbatim from Dashboard > Connect; URL-encode the password:
# @ -> %40, $ -> %24, : -> %3A, / -> %2F).
# App runtime — Transaction pooler (Supavisor), port 6543:
DATABASE_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@aws-1-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations / seed — Direct connection, port 5432, user is plain 'postgres':
DIRECT_URL="postgresql://postgres:ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"
PORT=8080
FOOTBALL_DATA_API_KEY=your_token_here
FOOTBALL_DATA_COMPETITION=PL
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
CLIENT_URL=your_client_url_here
RESEND_API_KEY=re_your_resend_api_key
